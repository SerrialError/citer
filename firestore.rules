rules_version = '2';

// Everything is public to read. Anyone signed in can create projects and add, edit, or remove
// citations in any project. Only a project's owner can rename or delete it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /projects/{project} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.owner == request.auth.uid;

      match /citations/{citation} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }
}
